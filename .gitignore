# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# pnpm lockfile — this project uses npm (package-lock.json is the source of
# truth, .npmrc sets legacy-peer-deps=true for npm). Ignore stray pnpm locks
# produced by someone running `pnpm install` locally so they don't confuse
# the Docker build.
pnpm-lock.yaml

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template. Without this negation `.env*` matches it
# too, and it stays visible only because it was added before the rule — delete
# and recreate it and git stops tracking it silently.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode (scripts/generate-seed.py)
__pycache__/
*.py[cod]

# claude code local settings
.claude/

# local AI agent tooling (Codex notes, skills) — keep local, do not commit
.agents/
AGENTS.md

# local AI agent scratch dirs — keep local, do not commit
.superpowers/
