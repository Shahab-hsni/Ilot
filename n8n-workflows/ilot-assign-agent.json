    {
      "parameters": {
        "jsCode": "// Pick the agent with the fewest open cases. Falls back gracefully if the\n// department has no active agents (returns assigned=false so caller can\n// alert ops instead of silently dropping the case).\n\nconst items = $input.all().map(i => i.json).filter(Boolean);\nconst trigger = $('When Called by #4').first().json;\n\nif (!items.length || !items[0] || items[0].Id === undefined) {\n  return [{ json: { assigned: false, reason: 'no_active_agent_in_department', ...trigger } }];\n}\n\n// Sort by open_cases asc (treat null/undefined as 0), tie-break by Id asc.\nconst sorted = items\n  .filter(a => a.Id !== undefined)\n  .sort((a, b) => {\n    const ao = Number(a.open_cases || 0);\n    const bo = Number(b.open_cases || 0);\n    if (ao !== bo) return ao - bo;\n    return Number(a.Id) - Number(b.Id);\n  });\n\nconst agent = sorted[0];\n\nreturn [{\n  json: {\n    assigned: true,\n    agent_id: agent.Id,\n    agent_name: agent.name,\n    agent_phone: agent.phone,\n    agent_slack: agent.slack_id || '',\n    agent_open_cases: Number(agent.open_cases || 0),\n    ...trigger\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
