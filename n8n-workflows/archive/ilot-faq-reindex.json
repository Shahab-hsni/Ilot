    {
      "parameters": {
        "jsCode": "// Convert each NocoDB FAQ row into the {pageContent, metadata} shape\n// the Default Data Loader / Simple Vector Store expect.\n//\n// pageContent = the embedded text (Question + Answer concatenated, so the\n// vector represents both — a customer query may match either side).\n// metadata    = anything the Agent might find useful in retrieval\n// (department for filtering, original question for citation, etc.).\n\nconst rows = $input.all().map(item => item.json);\n\nreturn rows\n  .filter(r => r.Question && r.Answer)\n  .map(r => ({\n    json: {\n      pageContent: `Q: ${r.Question}\\nA: ${r.Answer}`,\n      metadata: {\n        question:    r.Question,\n        answer:      r.Answer,\n        department:  r.Department ?? 'general',\n        rowId:       r.Id ?? null,\n        updatedAt:   r.UpdatedAt ?? null\n      }\n    }\n  }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 144],
      "id": "5e3f1a04-aaaa-4d7a-a5e1-0004formatdocs",
      "name": "Format as documents"
    },
    {
      "parameters": {
